{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.example/schemas/audit-report.v2.schema.json",
  "title": "Audit Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "task_id",
    "build_revision",
    "audit_round",
    "verdict",
    "summary",
    "scope_review",
    "verification_assessment",
    "findings",
    "regression_check",
    "what_held_up",
    "open_questions",
    "rework_brief",
    "escalation",
    "round_limit_reached"
  ],
  "properties": {
    "contract": { "const": "audit-report" },
    "version": { "const": 2 },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "build_revision": { "type": "integer", "minimum": 0, "maximum": 2 },
    "audit_round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "verdict": { "enum": ["PASS", "PASS_WITH_NOTES", "FAIL"] },
    "summary": { "type": "string", "minLength": 1 },
    "scope_review": { "$ref": "#/$defs/scopeReview" },
    "verification_assessment": { "$ref": "#/$defs/verificationAssessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "regression_check": {
      "type": "array",
      "items": { "$ref": "#/$defs/regressionItem" }
    },
    "what_held_up": { "type": "string", "minLength": 1 },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "rework_brief": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/reworkBrief" }
      ]
    },
    "escalation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/escalation" }
      ]
    },
    "round_limit_reached": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "audit_round": { "const": 1 } }, "required": ["audit_round"] },
      "then": { "properties": { "build_revision": { "const": 0 } } }
    },
    {
      "if": { "properties": { "audit_round": { "const": 2 } }, "required": ["audit_round"] },
      "then": { "properties": { "build_revision": { "const": 1 } } }
    },
    {
      "if": { "properties": { "audit_round": { "const": 3 } }, "required": ["audit_round"] },
      "then": { "properties": { "build_revision": { "const": 2 } } }
    },
    {
      "if": { "properties": { "audit_round": { "const": 1 } }, "required": ["audit_round"] },
      "then": { "properties": { "regression_check": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "verdict": { "enum": ["PASS", "PASS_WITH_NOTES"] } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "properties": { "severity": { "enum": ["BLOCKER", "MAJOR"] } },
                "required": ["severity"]
              }
            }
          },
          "rework_brief": { "type": "null" },
          "escalation": { "type": "null" },
          "round_limit_reached": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "PASS" } }, "required": ["verdict"] },
      "then": { "properties": { "findings": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "PASS_WITH_NOTES" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": { "severity": { "enum": ["MINOR", "NIT"] } },
              "required": ["severity"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "FAIL" },
          "audit_round": { "maximum": 2 }
        },
        "required": ["verdict", "audit_round"]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": { "severity": { "enum": ["BLOCKER", "MAJOR"] } },
              "required": ["severity"]
            },
            "minContains": 1
          },
          "rework_brief": { "$ref": "#/$defs/reworkBrief" },
          "escalation": { "type": "null" },
          "round_limit_reached": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "FAIL" },
          "audit_round": { "const": 3 }
        },
        "required": ["verdict", "audit_round"]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": { "severity": { "enum": ["BLOCKER", "MAJOR"] } },
              "required": ["severity"]
            },
            "minContains": 1
          },
          "rework_brief": { "type": "null" },
          "escalation": { "$ref": "#/$defs/escalation" },
          "round_limit_reached": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "scopeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_paths", "unavailable_context"],
      "properties": {
        "reviewed_paths": { "type": "array", "items": { "type": "string" } },
        "unavailable_context": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verificationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "enum": ["independently_executed", "provided_logs", "static_only", "not_run", "inconsistent"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "file",
        "lines",
        "quote",
        "trigger",
        "expected",
        "actual",
        "impact",
        "fix",
        "evidence_basis",
        "evidence_detail"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F[1-9][0-9]*$" },
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NIT"] },
        "category": {
          "enum": ["correctness", "security", "failure_handling", "verification_gap", "testing", "performance", "maintainability", "standards", "regression", "other"]
        },
        "file": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "lines": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "quote": { "type": "string" },
        "trigger": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 },
        "evidence_basis": { "enum": ["runtime_reproduced", "static_proof", "provided_log"] },
        "evidence_detail": { "type": "string", "minLength": 1 }
      }
    },
    "regressionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^F[1-9][0-9]*$" },
        "status": { "enum": ["fixed", "open", "not_verifiable", "reopened"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "reworkBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_fix", "frozen", "deferred", "constraints", "stop_conditions"],
      "properties": {
        "must_fix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^F[1-9][0-9]*$" }
        },
        "frozen": {
          "type": "array",
          "items": { "$ref": "#/$defs/frozenItem" }
        },
        "deferred": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^F[1-9][0-9]*$" }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^F[1-9][0-9]*: .+$" }
        }
      }
    },
    "frozenItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^F[1-9][0-9]*$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_causes", "human_decision", "cheapest_path"],
      "properties": {
        "root_causes": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "human_decision": { "type": "string", "minLength": 1 },
        "cheapest_path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
