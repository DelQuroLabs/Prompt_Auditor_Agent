{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.example/schemas/build-audit-handoff.v2.schema.json",
  "title": "Build-Audit Handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "task_id",
    "build_revision",
    "spec",
    "acceptance_criteria",
    "artifacts",
    "context_manifest",
    "verification",
    "self_audit",
    "assumptions",
    "flags",
    "open_questions",
    "confidence"
  ],
  "properties": {
    "contract": { "const": "build-audit-handoff" },
    "version": { "const": 2 },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "build_revision": { "type": "integer", "minimum": 0, "maximum": 2 },
    "spec": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "context_manifest": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextItem" }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verificationItem" }
    },
    "self_audit": {
      "type": "array",
      "items": { "$ref": "#/$defs/selfAuditItem" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "flags": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "base_revision": { "type": "string" },
    "confidence": { "enum": ["low", "medium", "high"] }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "lines_changed", "summary", "snapshot_included"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["new", "modified", "deleted"] },
        "lines_changed": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1 },
        "snapshot_included": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["new", "modified"] } }, "required": ["status"] },
          "then": { "properties": { "snapshot_included": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "const": "deleted" } }, "required": ["status"] },
          "then": { "properties": { "snapshot_included": { "const": false } } }
        }
      ]
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose", "supplied"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "supplied": { "type": "boolean" }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "command", "result", "environment", "evidence"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "result": { "enum": ["pass", "fail", "not-run"] },
        "environment": {
          "enum": ["agent_sandbox", "project_ci", "user_reported", "static_only", "not_run"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "environment": { "const": "not_run" } }, "required": ["environment"] },
          "then": { "properties": { "result": { "const": "not-run" } } }
        },
        {
          "if": { "properties": { "result": { "const": "not-run" } }, "required": ["result"] },
          "then": { "properties": { "evidence": { "minLength": 5 } } }
        }
      ]
    },
    "selfAuditItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "note", "severity", "confidence"],
      "properties": {
        "area": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NIT"] },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    }
  }
}